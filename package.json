{
  "name": "scarnergy-app",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "bash scripts/detect-dev-ip.sh",
    "start": "expo start --port 8085",
    "start:clear": "bash scripts/detect-dev-ip.sh && expo start --clear --port 8085",
    "start:tunnel": "expo start --tunnel --port 8085",
    "start:tunnel:clear": "expo start --tunnel --clear --port 8085",
    "tunnel": "/tmp/cf/usr/bin/cloudflared tunnel --url http://localhost:8085 --logfile /tmp/cf-expo2.log",
    "tunnel:url": "grep -o 'https://[^ ]*\\.trycloudflare\\.com' /tmp/cf-expo2.log | tail -1",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "build:ios:cloud": "bash scripts/eas-build-ios.sh",
    "test": "jest",
    "postinstall": "chmod +x node_modules/.bin/* && node scripts/patch-ngrok.js"
  },
  "jest": {
    "preset": "ts-jest/presets/default",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "jsx": "react",
          "esModuleInterop": true
        }
      }
    }
  },
  "dependencies": {
    "@expo/cli": "^54.0.23",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.43.0",
    "@tanstack/react-query": "^5.40.0",
    "@types/react": "~19.1.10",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.1.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.14",
    "typescript": "^5.4.5"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
